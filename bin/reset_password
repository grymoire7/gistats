#!/usr/bin/env php
<?php
declare(strict_types=1);

require __DIR__ . '/../lib/db.php';
require __DIR__ . '/../lib/auth.php';

function print_usage(): string
{
    return <<<USAGE
Usage: bin/reset_password <username> <password>

Resets a user's password directly in the database. Use this when you're
locked out and can't reach the in-app "Change Password" form.

Arguments:
  username   Existing username to reset the password for.
  password   New password (minimum 8 characters).

Options:
  -h, --help  Show this help message.

USAGE;
}

$args = array_slice($argv, 1);

if (in_array('--help', $args, true) || in_array('-h', $args, true)) {
    echo print_usage();
    exit(0);
}

if (count($args) !== 2) {
    fwrite(STDERR, print_usage());
    exit(1);
}

[$username, $password] = $args;

if (strlen($password) < 8) {
    fwrite(STDERR, "Error: password must be at least 8 characters.\n");
    exit(1);
}

$config = require __DIR__ . '/../config.php';
DB::init($config);

if (!reset_password($username, $password)) {
    fwrite(STDERR, "Error: no user found with username \"{$username}\".\n");
    exit(1);
}

echo "Password updated.\n";
exit(0);
