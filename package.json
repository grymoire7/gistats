{
    "name": "gistats",
    "version": "1.0.0",
    "scripts": {
        "build:css": "tailwindcss -i css/input.css -o css/compiled.css --minify",
        "watch:css": "tailwindcss -i css/input.css -o css/compiled.css --watch",
        "server:start": "php -S localhost:8300 server.php 2>&1",
        "test": "vendor/bin/phpunit",
        "test:integration": "playwright test",
        "test:syntax": "git ls-files '*.php' | xargs -n1 -P4 php -l"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/cli": "^4.1.18",
        "tailwindcss": "^4.1.18"
    }
}
